// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Officer {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())

  // Back-relations
  auditLogs    AuditLog[]
  bidders      Bidder[]   // bidders created by this officer
}

model Bidder {
  id             String    @id @default(cuid())
  name           String
  gstin          String
  pan            String
  udyam          String
  tenderId       String
  tenderName     String
  score          Int?      // null until verification pipeline runs
  risk           String?   // "low" | "medium" | "high" — null until verified
  status         String    @default("pending_review") // pending_review | approved | rejected
  recommendation String?
  createdById    String    // FK → Officer who submitted this bidder
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy Officer    @relation(fields: [createdById], references: [id])
  documents Document[]
  checks    Check[]
  auditLogs AuditLog[]
}

model Document {
  id         String   @id @default(cuid())
  bidderId   String
  type       String   // PAN | GST | UDYAM
  fileName   String
  filePath   String   // disk path: /uploads/{bidderId}/{filename}
  uploadedAt DateTime @default(now())

  bidder Bidder @relation(fields: [bidderId], references: [id])
}

model Check {
  id        String   @id @default(cuid())
  bidderId  String
  label     String
  category  String   // "statutory" | "tender_specific"
  state     String   // pass | warn | missing | fail | na
  live      Boolean
  note      String
  weight    Int
  createdAt DateTime @default(now())

  bidder Bidder @relation(fields: [bidderId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  bidderId  String
  officerId String?  // null for System-generated entries
  actor     String   // "System" for automated entries; officer name for human decisions
  action    String
  timestamp DateTime @default(now())

  bidder  Bidder   @relation(fields: [bidderId], references: [id])
  officer Officer? @relation(fields: [officerId], references: [id])
}
